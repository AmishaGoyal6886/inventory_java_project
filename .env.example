# Copy this file to .env and set these values for your local MySQL instance.
DB_URL=jdbc:mysql://localhost:3306/stockroom?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=stockroom
DB_PASSWORD=replace_with_a_long_random_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_random_password
PORT=8080
